{
  "manifest_version": 3,
  "name": "Incerto for Wikipedia",
  "short_name": "Incerto",
  "version": "2.0.0",
  "description": "Typesets Wikipedia like Nassim Taleb's Technical Incerto, with pages stacked side by side, highlights and notes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Incerto typesetting",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.wikipedia.org/wiki/*",
        "*://*.wikipedia.org/w/index.php*"
      ],
      "css": [
        "incerto.css",
        "chrome.css",
        "stack.css",
        "annotate.css"
      ],
      "js": [
        "incerto.js",
        "stack.js",
        "annotate.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "page-hook.js"
      ],
      "matches": [
        "*://*.wikipedia.org/*"
      ]
    }
  ]
}
